# ═══════════════════════════════════════════════════════════
# CampusPath 环境变量模板
#
# 用法：cp .env.example .env  然后填入真实值
# .env 已被 .gitignore 排除，绝不会进版本库
#
# 凡是密钥、token、client secret，只写进 .env，
# 不写进任何 .md / .py / .ts / 提交信息 / 网页
# ═══════════════════════════════════════════════════════════

# ── Google Cloud 基础 ────────────────────────────────────
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_REGION=
GCP_BILLING_ACCOUNT=

# ── Vertex AI ────────────────────────────────────────────
# 注意：只走 Vertex AI，不用 AI Studio 的 API key
# 原因见 CLAUDE.md —— AI Studio 的调用不吃赠金
VERTEX_LOCATION=us-central1
GEMINI_MODEL_PRIMARY=
GEMINI_MODEL_CHEAP=

# ── 后端选择：这三行决定钱扣在哪里 ──────────────────────────────
# google-genai / ADK 靠**环境变量**选后端。GOOGLE_GENAI_USE_VERTEXAI
# 没设或为 false 时默认走 AI Studio，并从 GOOGLE_API_KEY 取密钥——
# 那条路不吃赠金，直扣个人信用卡。一行 Python 都不用改就能走错。
#
# 因此 campuspath_agents.vertex.assert_vertex_only() 在构造任何 Agent 前
# 会检查这三项，缺一就拒绝构造。
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=keen-opus-498918-m8
GOOGLE_CLOUD_LOCATION=us-central1

# 🚫 **不要**设置 GOOGLE_API_KEY 或 GEMINI_API_KEY。
# Vertex 走 ADC（gcloud auth application-default login），不需要任何 key。
# 设了就说明有人在走 AI Studio，守卫会拒绝构造 Agent。

# ── OAuth（Calendar / Gmail，代表用户访问）───────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Demo 用测试身份（合成，非真实学生）──────────────────
DEMO_CALENDAR_ACCOUNT=
DEMO_COUNSELING_INBOX=

# ── Moodle 沙箱 ──────────────────────────────────────────
MOODLE_BASE_URL=
MOODLE_WS_TOKEN=
MOODLE_DEMO_ADMIN_USER=
MOODLE_DEMO_ADMIN_PASSWORD=

# ── 应用服务 ─────────────────────────────────────────────
FIRESTORE_DATABASE=
GCS_BUCKET_PRIVATE=
API_BASE_URL=

# 访问口令门（2026-08-02，取代 Google 邮箱白名单）：设了才开门；本地开发不设
CAMPUSPATH_DEMO_PASSCODE=
