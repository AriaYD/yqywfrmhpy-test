{
  "$defs": {
    "CohortDims": {
      "additionalProperties": false,
      "description": "粗粒度分组维度。**只有这三项**——细到专业方向以下就可能反查到个人。\n\n三个字段都是**受约束类型**，不是自由文本。此前 ``school`` 与\n``development_mode`` 是裸 ``str``，于是\n``school=\"ENGG/COMP/AI-track/2024-intake/GPA3.7-3.8\"`` 完全合法——\n§17.1.2 要求\"仅粗粒度分组、不含专业方向以下的细分\"，\n而把细分塞进一个字符串既绕过了这条，也绕过了维度层数限制。",
      "properties": {
        "development_mode": {
          "$ref": "#/components/schemas/DevelopmentModeType",
          "description": "用枚举而非自由文本。枚举本来就存在，此前只是没接上"
        },
        "school": {
          "description": "学院代码，例如 'ENGG'。限制成短代码，塞不下更细的分层",
          "pattern": "^[A-Z]{2,6}$",
          "title": "School",
          "type": "string"
        },
        "year_level": {
          "maximum": 8,
          "minimum": 1,
          "title": "Year Level",
          "type": "integer"
        }
      },
      "required": [
        "school",
        "year_level",
        "development_mode"
      ],
      "title": "CohortDims",
      "type": "object"
    },
    "DevelopmentModeType": {
      "enum": [
        "employment",
        "academia",
        "entrepreneurship",
        "personal_interest",
        "exploration"
      ],
      "title": "DevelopmentModeType",
      "type": "string"
    },
    "DimensionAggregate": {
      "additionalProperties": false,
      "properties": {
        "ci_high": {
          "maximum": 5,
          "minimum": 1,
          "title": "Ci High",
          "type": "number"
        },
        "ci_low": {
          "maximum": 5,
          "minimum": 1,
          "title": "Ci Low",
          "type": "number"
        },
        "dimension": {
          "$ref": "#/components/schemas/QualityDimension"
        },
        "weighted_score": {
          "maximum": 5,
          "minimum": 1,
          "title": "Weighted Score",
          "type": "number"
        }
      },
      "required": [
        "dimension",
        "weighted_score",
        "ci_low",
        "ci_high"
      ],
      "title": "DimensionAggregate",
      "type": "object"
    },
    "QualityDimension": {
      "description": "固定维度。新增维度要改 Spec，不能由前端随手加一个自由文本问题。",
      "enum": [
        "content_depth",
        "organization",
        "practical_value",
        "networking_value",
        "expectation_match"
      ],
      "title": "QualityDimension",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/EventQualityAggregate.json",
  "additionalProperties": false,
  "description": "活动质量聚合（Spec §14.4）。时间衰减 + 届次/系列分层 + 样本阈值。",
  "properties": {
    "aggregate_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Aggregate Id",
      "type": "string"
    },
    "cohort": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/CohortDims"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dimensions": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/DimensionAggregate"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "last_updated": {
      "format": "date-time",
      "title": "Last Updated",
      "type": "string"
    },
    "occurrence_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurrence Id"
    },
    "series_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Series Id"
    },
    "time_decay_half_life_days": {
      "default": 365,
      "minimum": 30,
      "title": "Time Decay Half Life Days",
      "type": "integer"
    },
    "verified_n": {
      "minimum": 0,
      "title": "Verified N",
      "type": "integer"
    }
  },
  "required": [
    "aggregate_id",
    "verified_n",
    "last_updated"
  ],
  "title": "EventQualityAggregate",
  "type": "object"
}
