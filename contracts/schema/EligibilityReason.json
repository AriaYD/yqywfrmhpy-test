{
  "$defs": {
    "EligibilityRuleKind": {
      "enum": [
        "year_level",
        "program",
        "gpa",
        "prerequisite_course",
        "work_authorization",
        "language",
        "membership",
        "application_window",
        "other"
      ],
      "title": "EligibilityRuleKind",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/EligibilityReason.json",
  "additionalProperties": false,
  "properties": {
    "detail": {
      "$ref": "#/components/schemas/LocalizedText"
    },
    "rule_kind": {
      "$ref": "#/components/schemas/EligibilityRuleKind"
    },
    "satisfied": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None 表示信息不足——这本身就是 needs_confirmation 的依据",
      "title": "Satisfied"
    },
    "source_tier": {
      "title": "Source Tier",
      "type": "string"
    }
  },
  "required": [
    "rule_kind",
    "detail",
    "source_tier"
  ],
  "title": "EligibilityReason",
  "type": "object"
}
