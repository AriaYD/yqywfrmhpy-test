{
  "$defs": {
    "DataUncertainty": {
      "additionalProperties": false,
      "description": "A2 的产出之一：明确说\"这个字段我不确定\"，而不是猜一个值填上（Spec §8.1.1）。",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "kind": {
          "$ref": "#/components/schemas/Uncertainty"
        },
        "suggested_action": {
          "default": "none",
          "enum": [
            "ask_student",
            "consult_advisor",
            "check_source",
            "none"
          ],
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "kind"
      ],
      "title": "DataUncertainty",
      "type": "object"
    },
    "DegreeRequirementProgress": {
      "additionalProperties": false,
      "description": "学生在某条要求上的进度。satisfied_by 必须指向真实的课程记录。",
      "properties": {
        "earned_credits": {
          "default": 0.0,
          "minimum": 0,
          "title": "Earned Credits",
          "type": "number"
        },
        "remaining_credits": {
          "default": 0.0,
          "minimum": 0,
          "title": "Remaining Credits",
          "type": "number"
        },
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "satisfied": {
          "default": false,
          "title": "Satisfied",
          "type": "boolean"
        },
        "satisfied_by": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Satisfied By",
          "type": "array"
        }
      },
      "required": [
        "requirement_id"
      ],
      "title": "DegreeRequirementProgress",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "Uncertainty": {
      "description": "字段级不确定性。``NEEDS_CONFIRMATION`` 永远不能被当成淘汰依据（Spec §16.2）。",
      "enum": [
        "none",
        "low_confidence",
        "missing_source_field",
        "conflicting_sources",
        "needs_confirmation"
      ],
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/DegreeProgress.json",
  "additionalProperties": false,
  "description": "A2 输出。纯事实聚合，不含\"你应该先修哪门\"这类建议。",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "program_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Program Id",
      "type": "string"
    },
    "requirement_progress": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/DegreeRequirementProgress"
      },
      "title": "Requirement Progress",
      "type": "array"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "total_earned_credits": {
      "minimum": 0,
      "title": "Total Earned Credits",
      "type": "number"
    },
    "total_required_credits": {
      "exclusiveMinimum": 0,
      "title": "Total Required Credits",
      "type": "number"
    },
    "uncertainties": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/DataUncertainty"
      },
      "title": "Uncertainties",
      "type": "array"
    }
  },
  "required": [
    "student_id",
    "program_id",
    "as_of",
    "total_earned_credits",
    "total_required_credits"
  ],
  "title": "DegreeProgress",
  "type": "object"
}
