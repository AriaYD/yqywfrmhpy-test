{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/ScheduleConflict.json",
  "additionalProperties": false,
  "properties": {
    "blocking": {
      "description": "True 表示不得静默排程，必须显式警告或改期",
      "title": "Blocking",
      "type": "boolean"
    },
    "conflict_type": {
      "enum": [
        "protected_block",
        "busy_overlap",
        "exam",
        "prerequisite_timing",
        "capacity_exceeded",
        "travel_infeasible"
      ],
      "title": "Conflict Type",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/LocalizedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "with_block_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "With Block Id"
    }
  },
  "required": [
    "conflict_type",
    "blocking"
  ],
  "title": "ScheduleConflict",
  "type": "object"
}
