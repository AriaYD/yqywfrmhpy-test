{
  "$defs": {
    "RoutineWindow": {
      "additionalProperties": false,
      "description": "一天内的一段固定作息，如 12:00–13:00 午饭。",
      "properties": {
        "end": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "End",
          "type": "string"
        },
        "start": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "RoutineWindow",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/RoutineRequest.json",
  "additionalProperties": false,
  "description": "M（2026-07-31）：学生**显式提交**自己的日常作息（§16.8.2：不得从日历反推）。\n\n睡眠与用餐生成保护时段块，但**不再从可支配容量里扣**——\n§16.7 的每周可支配小时数本来就不含它们，再扣一次人人都是负容量。",
  "properties": {
    "meals": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/RoutineWindow"
      },
      "maxItems": 4,
      "title": "Meals",
      "type": "array"
    },
    "sleep": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/RoutineWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "RoutineRequest",
  "type": "object"
}
