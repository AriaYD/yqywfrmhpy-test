{
  "$defs": {
    "CoursePlanItem": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "course_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Course Id",
          "type": "string"
        },
        "credits": {
          "minimum": 0,
          "title": "Credits",
          "type": "number"
        },
        "offering_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offering Id"
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "term": {
          "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
          "title": "Term",
          "type": "string"
        },
        "validation_id": {
          "description": "Rules 对该课程项的校验凭据；缺失即被 API 拒绝（Spec §8.9.3）",
          "pattern": "^val_[0-9a-f]{32}$",
          "title": "Validation Id",
          "type": "string"
        }
      },
      "required": [
        "course_id",
        "term",
        "credits",
        "validation_id"
      ],
      "title": "CoursePlanItem",
      "type": "object"
    },
    "CoursePlanVariant": {
      "description": "S1 ParallelAgent 的三套约束强度（Spec §8.1 表 S1）。",
      "enum": [
        "balanced",
        "ambitious",
        "low_load"
      ],
      "title": "CoursePlanVariant",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/CoursePlan.json",
  "additionalProperties": false,
  "description": "A5 产出。三个变体由 S1 `ParallelAgent` 并行生成。",
  "properties": {
    "confidence": {
      "default": 0.5,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "course_items": {
      "items": {
        "$ref": "#/components/schemas/CoursePlanItem"
      },
      "minItems": 1,
      "title": "Course Items",
      "type": "array"
    },
    "degree_value": {
      "title": "Degree Value",
      "type": "number"
    },
    "explanation": {
      "$ref": "#/components/schemas/LocalizedText"
    },
    "gap_value": {
      "title": "Gap Value",
      "type": "number"
    },
    "goal_value": {
      "description": "A5 的取舍分数。只有 A5 的输出允许出现分数",
      "title": "Goal Value",
      "type": "number"
    },
    "plan_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "term": {
      "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
      "title": "Term",
      "type": "string"
    },
    "total_credits": {
      "minimum": 0,
      "title": "Total Credits",
      "type": "number"
    },
    "validation_ids": {
      "items": {
        "pattern": "^val_[0-9a-f]{32}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Validation Ids",
      "type": "array"
    },
    "variant": {
      "$ref": "#/components/schemas/CoursePlanVariant"
    },
    "workload_cost": {
      "default": 0.0,
      "title": "Workload Cost",
      "type": "number"
    }
  },
  "required": [
    "plan_id",
    "student_id",
    "variant",
    "term",
    "course_items",
    "total_credits",
    "goal_value",
    "degree_value",
    "gap_value",
    "explanation",
    "validation_ids"
  ],
  "title": "CoursePlan",
  "type": "object"
}
