{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "ValidationIssueSeverity": {
      "enum": [
        "info",
        "warning",
        "blocking"
      ],
      "title": "ValidationIssueSeverity",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/ValidationIssue.json",
  "additionalProperties": false,
  "description": "确定性 Schema 闸门的输出。blocking 项**直接丢弃并告警，不回喂 LLM 重试**\n（Spec §8.9.1 第 3 条）。",
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "detail": {
      "$ref": "#/components/schemas/LocalizedText"
    },
    "field_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field Path"
    },
    "severity": {
      "$ref": "#/components/schemas/ValidationIssueSeverity"
    }
  },
  "required": [
    "code",
    "severity",
    "detail"
  ],
  "title": "ValidationIssue",
  "type": "object"
}
