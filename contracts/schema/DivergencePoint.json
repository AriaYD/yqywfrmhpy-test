{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/DivergencePoint.json",
  "additionalProperties": false,
  "description": "G3：两条路开始要求不同投入的时点，也是学生必须做选择的时点。",
  "properties": {
    "at_term": {
      "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
      "title": "At Term",
      "type": "string"
    },
    "candidate_only_requirement_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Candidate Only Requirement Ids",
      "type": "array"
    },
    "description": {
      "$ref": "#/components/schemas/LocalizedText"
    },
    "primary_only_requirement_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Primary Only Requirement Ids",
      "type": "array"
    }
  },
  "required": [
    "at_term",
    "description"
  ],
  "title": "DivergencePoint",
  "type": "object"
}
