{
  "$defs": {
    "EducationEntry": {
      "additionalProperties": false,
      "description": "R5-B（2026-08-01）：教育经历——高中到研究生，含夏令营/交换/驾校等。",
      "properties": {
        "end_year": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Year"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "program": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program"
        },
        "school": {
          "maxLength": 200,
          "minLength": 1,
          "title": "School",
          "type": "string"
        },
        "start_year": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Year"
        }
      },
      "required": [
        "school"
      ],
      "title": "EducationEntry",
      "type": "object"
    },
    "LanguageSkill": {
      "additionalProperties": false,
      "description": "语言：流利程度由学生自填；有考级也一并填。",
      "properties": {
        "certification": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "考级情况（如 IELTS 7.0），可空",
          "title": "Certification"
        },
        "language": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "proficiency": {
          "description": "入门/初级/流利/接近母语等，学生自评",
          "maxLength": 60,
          "minLength": 1,
          "title": "Proficiency",
          "type": "string"
        }
      },
      "required": [
        "language",
        "proficiency"
      ],
      "title": "LanguageSkill",
      "type": "object"
    },
    "ProfileEntry": {
      "additionalProperties": false,
      "description": "通用条目：出版物 / 荣誉奖项 / 组织机构成员。",
      "properties": {
        "date": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "issuer": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "title"
      ],
      "title": "ProfileEntry",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/ProfileExtras.json",
  "additionalProperties": false,
  "description": "R5-B：LinkedIn 式档案的补充分区（学业记录/证据之外的自述部分）。\n\n全部由学生自填自改（同 contacts 的先例：B3 挡 Agent 暗改，不挡本人）。\n与 SIS/证据派生的分区不同，这里没有\"核验状态\"——它整体就是自述。",
  "properties": {
    "certificates": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/ProfileEntry"
      },
      "maxItems": 20,
      "title": "Certificates",
      "type": "array"
    },
    "education": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/EducationEntry"
      },
      "maxItems": 10,
      "title": "Education",
      "type": "array"
    },
    "hobbies": {
      "default": [],
      "description": "与专业无关的个人爱好（弹琴/舞蹈/作曲等）",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Hobbies",
      "type": "array"
    },
    "honors": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/ProfileEntry"
      },
      "maxItems": 20,
      "title": "Honors",
      "type": "array"
    },
    "languages": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/LanguageSkill"
      },
      "maxItems": 10,
      "title": "Languages",
      "type": "array"
    },
    "organizations": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/ProfileEntry"
      },
      "maxItems": 20,
      "title": "Organizations",
      "type": "array"
    },
    "publications": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/ProfileEntry"
      },
      "maxItems": 20,
      "title": "Publications",
      "type": "array"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "updated_at"
  ],
  "title": "ProfileExtras",
  "type": "object"
}
