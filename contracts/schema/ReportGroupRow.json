{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/ReportGroupRow.json",
  "additionalProperties": false,
  "properties": {
    "activities_n": {
      "minimum": 0,
      "title": "Activities N",
      "type": "integer"
    },
    "attend_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attend Count"
    },
    "avg_overall": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Avg Overall"
    },
    "favorable_rate": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Favorable Rate"
    },
    "feedback_n": {
      "minimum": 0,
      "title": "Feedback N",
      "type": "integer"
    },
    "key": {
      "maxLength": 120,
      "title": "Key",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/LocalizedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verified_n": {
      "minimum": 0,
      "title": "Verified N",
      "type": "integer"
    }
  },
  "required": [
    "key",
    "activities_n",
    "feedback_n",
    "verified_n"
  ],
  "title": "ReportGroupRow",
  "type": "object"
}
