{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/AffectedScope.json",
  "additionalProperties": false,
  "description": "Event Monitor 的计算结果。**必须同时列出不受影响的范围**——\n\nT5 判的是\"只改受影响路径\"，只给受影响列表无法证伪\"顺手把别的也改了\"。",
  "properties": {
    "affected_goal_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Goal Ids",
      "type": "array"
    },
    "affected_milestone_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Milestone Ids",
      "type": "array"
    },
    "affected_plan_item_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Plan Item Ids",
      "type": "array"
    },
    "rationale": {
      "$ref": "#/components/schemas/LocalizedText"
    },
    "unaffected_plan_item_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Unaffected Plan Item Ids",
      "type": "array"
    }
  },
