{
  "$defs": {
    "GrowthTrajectoryPoint": {
      "additionalProperties": false,
      "properties": {
        "gaps_closed": {
          "minimum": 0,
          "title": "Gaps Closed",
          "type": "integer"
        },
        "goal_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Goal Confidence",
          "type": "number"
        },
        "new_confirmed_evidence": {
          "minimum": 0,
          "title": "New Confirmed Evidence",
          "type": "integer"
        },
        "term": {
          "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
          "title": "Term",
          "type": "string"
        },
        "verified_growth_actions": {
          "minimum": 0,
          "title": "Verified Growth Actions",
          "type": "integer"
        }
      },
      "required": [
        "term",
        "gaps_closed",
        "new_confirmed_evidence",
        "goal_confidence",
        "verified_growth_actions"
      ],
      "title": "GrowthTrajectoryPoint",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/GrowthTrajectory.json",
  "additionalProperties": false,
  "description": "G4（Spec §17.3.1）。纯派生，无 Agent 参与，因此可被逐字段单测。",
  "properties": {
    "computed_at": {
      "format": "date-time",
      "title": "Computed At",
      "type": "string"
    },
    "goal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Goal Id",
      "type": "string"
    },
    "points": {
      "items": {
        "$ref": "#/components/schemas/GrowthTrajectoryPoint"
      },
      "minItems": 1,
      "title": "Points",
      "type": "array"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "goal_id",
    "points",
    "computed_at"
  ],
  "title": "GrowthTrajectory",
  "type": "object"
}
