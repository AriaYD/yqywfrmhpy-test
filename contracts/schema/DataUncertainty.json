{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "Uncertainty": {
      "description": "字段级不确定性。``NEEDS_CONFIRMATION`` 永远不能被当成淘汰依据（Spec §16.2）。",
      "enum": [
        "none",
        "low_confidence",
        "missing_source_field",
        "conflicting_sources",
        "needs_confirmation"
      ],
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/DataUncertainty.json",
  "additionalProperties": false,
  "description": "A2 的产出之一：明确说\"这个字段我不确定\"，而不是猜一个值填上（Spec §8.1.1）。",
  "properties": {
    "detail": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/LocalizedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "field_path": {
      "title": "Field Path",
      "type": "string"
    },
    "kind": {
      "$ref": "#/components/schemas/Uncertainty"
    },
    "suggested_action": {
      "default": "none",
      "enum": [
        "ask_student",
        "consult_advisor",
        "check_source",
        "none"
      ],
      "title": "Suggested Action",
      "type": "string"
    }
  },
  "required": [
    "field_path",
    "kind"
  ],
  "title": "DataUncertainty",
  "type": "object"
}
