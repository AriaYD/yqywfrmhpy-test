{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "RequirementCategory": {
      "description": "出域时 ``MetricTuple.uncovered_requirement_categories`` 只携带这一层。\n\n它必须足够粗，粗到无法反推是哪位学生——所以是枚举而不是自由文本。",
      "enum": [
        "coursework",
        "technical_skill",
        "research_experience",
        "industry_experience",
        "project_portfolio",
        "teamwork_evidence",
        "communication",
        "credential",
        "language",
        "network",
        "eligibility_status"
      ],
      "title": "RequirementCategory",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/SharedGap.json",
  "additionalProperties": false,
  "description": "G3：主目标与候选目标共同需要的缺口——学生做这件事两条路都不亏。",
  "properties": {
    "category": {
      "$ref": "#/components/schemas/RequirementCategory"
    },
    "description": {
      "$ref": "#/components/schemas/LocalizedText"
    },
    "requirement_ids_candidate": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Requirement Ids Candidate",
      "type": "array"
    },
    "requirement_ids_primary": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Requirement Ids Primary",
      "type": "array"
    }
  },
  "required": [
    "requirement_ids_primary",
    "requirement_ids_candidate",
    "category",
    "description"
  ],
  "title": "SharedGap",
  "type": "object"
}
