{
  "$defs": {
    "CalendarDetailLevel": {
      "description": "采集层级。**两级，学生各自授权，默认只有第一级。**\n\n产品上的取舍：只知道忙/闲的系统只能说\"你没空了\"；知道标题才说得出\n\"这个周三的例会也许可以缺一次\"。后者是学生明确要的能力，所以它是\n一个**可选的第二级授权**，而不是默认打开、也不是永远不做。\n\n``AvailabilityBlock.title`` 只在 :attr:`EVENT_TITLES` 下才允许有值，\n由 ``_title_requires_grant`` 在类型层强制——\n\"没授权却带了标题\"因此构造不出来，不靠调用方记得过滤。",
      "enum": [
        "free_busy_only",
        "event_titles"
      ],
      "title": "CalendarDetailLevel",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/CalendarSyncReceipt.json",
  "additionalProperties": false,
  "description": "一次 free/busy 拉取的审计记录。用于证明我们只取了 free/busy。",
  "properties": {
    "block_count": {
      "minimum": 0,
      "title": "Block Count",
      "type": "integer"
    },
    "connection_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Connection Id",
      "type": "string"
    },
    "detail_level": {
      "$ref": "#/components/schemas/CalendarDetailLevel",
      "default": "free_busy_only"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "connection_id",
    "fetched_at",
    "window_start",
    "window_end",
    "block_count"
  ],
  "title": "CalendarSyncReceipt",
  "type": "object"
}
