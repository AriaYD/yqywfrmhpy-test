{
  "$defs": {
    "AvailabilityType": {
      "description": "Spec §16.6 的五类时段。",
      "enum": [
        "busy",
        "free",
        "protected",
        "buffer",
        "flexible"
      ],
      "title": "AvailabilityType",
      "type": "string"
    },
    "BlockSource": {
      "enum": [
        "calendar_freebusy",
        "student_defined",
        "course_timetable",
        "derived"
      ],
      "title": "BlockSource",
      "type": "string"
    },
    "CalendarDetailLevel": {
      "description": "采集层级。**两级，学生各自授权，默认只有第一级。**\n\n产品上的取舍：只知道忙/闲的系统只能说\"你没空了\"；知道标题才说得出\n\"这个周三的例会也许可以缺一次\"。后者是学生明确要的能力，所以它是\n一个**可选的第二级授权**，而不是默认打开、也不是永远不做。\n\n``AvailabilityBlock.title`` 只在 :attr:`EVENT_TITLES` 下才允许有值，\n由 ``_title_requires_grant`` 在类型层强制——\n\"没授权却带了标题\"因此构造不出来，不靠调用方记得过滤。",
      "enum": [
        "free_busy_only",
        "event_titles"
      ],
      "title": "CalendarDetailLevel",
      "type": "string"
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/AvailabilityBlock.json",
  "additionalProperties": false,
  "description": "一段被分类过的时间。只有起止、类型、来源——**没有内容**。",
  "properties": {
    "block_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Block Id",
      "type": "string"
    },
    "detail_level": {
      "$ref": "#/components/schemas/CalendarDetailLevel",
      "default": "free_busy_only"
    },
    "privacy_level": {
      "default": "opaque",
      "enum": [
        "opaque",
        "student_defined"
      ],
      "title": "Privacy Level",
      "type": "string"
    },
    "reachable": {
      "default": true,
      "description": "跨地点无法到达的空档不计入 Usable Free Time（Spec §16.6）",
      "title": "Reachable",
      "type": "boolean"
    },
    "reminder_minutes_before": {
      "anyOf": [
        {
          "maximum": 10080,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A（2026-07-31）：学生给自己视图里的行程设的提醒。只属于 CampusPath 视图，不回写权威日历",
      "title": "Reminder Minutes Before"
    },
    "source": {
      "$ref": "#/components/schemas/BlockSource"
    },
    "span": {
      "$ref": "#/components/schemas/TimeRange"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "事件标题。**只有 detail_level 为 event_titles 时才允许有值**——学生没授权二级就带着标题的区块，在类型层构造不出来",
      "title": "Title"
    },
    "type": {
      "$ref": "#/components/schemas/AvailabilityType"
    }
  },
  "required": [
    "block_id",
    "student_id",
    "span",
    "type",
    "source"
  ],
  "title": "AvailabilityBlock",
  "type": "object"
}
