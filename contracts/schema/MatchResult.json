{
  "$defs": {
    "EligibilityAssessment": {
      "additionalProperties": false,
      "description": "由 Rules & Constraint Engine 判定，A5 只负责解释（Spec §16.5 步骤 1–2）。\n\n**无分数字段。** 排序发生在 :class:`MatchResult`，那是 A5 的产出。",
      "properties": {
        "assessment_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "blocking_requirement_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Blocking Requirement Ids",
          "type": "array"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "next_eligibility_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Eligibility Date"
        },
        "opportunity_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Opportunity Id",
          "type": "string"
        },
        "reasons": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/EligibilityReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "state": {
          "$ref": "#/components/schemas/EligibilityStateName"
        },
        "validation_id": {
          "description": "Spec §8.9.3：每一条资格结论必须携带 Rules 的校验凭据",
          "pattern": "^val_[0-9a-f]{32}$",
          "title": "Validation Id",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "opportunity_id",
        "state",
        "validation_id",
        "evaluated_at"
      ],
      "title": "EligibilityAssessment",
      "type": "object"
    },
    "EligibilityReason": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "rule_kind": {
          "$ref": "#/components/schemas/EligibilityRuleKind"
        },
        "satisfied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None 表示信息不足——这本身就是 needs_confirmation 的依据",
          "title": "Satisfied"
        },
        "source_tier": {
          "title": "Source Tier",
          "type": "string"
        }
      },
      "required": [
        "rule_kind",
        "detail",
        "source_tier"
      ],
      "title": "EligibilityReason",
      "type": "object"
    },
    "EligibilityRuleKind": {
      "enum": [
        "year_level",
        "program",
        "gpa",
        "prerequisite_course",
        "work_authorization",
        "language",
        "membership",
        "application_window",
        "other"
      ],
      "title": "EligibilityRuleKind",
      "type": "string"
    },
    "EligibilityStateName": {
      "description": "Spec §16.1。四态，不是两态。",
      "enum": [
        "eligible_now",
        "future_eligible",
        "needs_confirmation",
        "ineligible_current_cycle"
      ],
      "title": "EligibilityStateName",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "MatchScoreBreakdown": {
      "additionalProperties": false,
      "description": "Spec §16.3 的六项权重。**只有 A5 允许产出分数。**\n\n拆开而不是只给一个百分比，是因为 §16.3 要求\"每条结果必须显示为什么推荐\"。",
      "properties": {
        "event_quality_source_trust": {
          "maximum": 1,
          "minimum": 0,
          "title": "Event Quality Source Trust",
          "type": "number"
        },
        "evidence_portfolio_value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Portfolio Value",
          "type": "number"
        },
        "gap_reduction_value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Gap Reduction Value",
          "type": "number"
        },
        "goal_alignment": {
          "maximum": 1,
          "minimum": 0,
          "title": "Goal Alignment",
          "type": "number"
        },
        "personal_preference_fit": {
          "maximum": 1,
          "minimum": 0,
          "title": "Personal Preference Fit",
          "type": "number"
        },
        "workload_energy_fit": {
          "maximum": 1,
          "minimum": 0,
          "title": "Workload Energy Fit",
          "type": "number"
        }
      },
      "required": [
        "goal_alignment",
        "gap_reduction_value",
        "evidence_portfolio_value",
        "workload_energy_fit",
        "personal_preference_fit",
        "event_quality_source_trust"
      ],
      "title": "MatchScoreBreakdown",
      "type": "object"
    },
    "Uncertainty": {
      "description": "字段级不确定性。``NEEDS_CONFIRMATION`` 永远不能被当成淘汰依据（Spec §16.2）。",
      "enum": [
        "none",
        "low_confidence",
        "missing_source_field",
        "conflicting_sources",
        "needs_confirmation"
      ],
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/MatchResult.json",
  "additionalProperties": false,
  "description": "A5 产出。资格结论直接内嵌，避免\"分数高但没资格\"被单独展示。",
  "properties": {
    "breakdown": {
      "$ref": "#/components/schemas/MatchScoreBreakdown"
    },
    "covered_requirement_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Covered Requirement Ids",
      "type": "array"
    },
    "eligibility": {
      "$ref": "#/components/schemas/EligibilityAssessment"
    },
    "freshness_days": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freshness Days"
    },
    "gap_value": {
      "minimum": 0,
      "title": "Gap Value",
      "type": "number"
    },
    "goal_role": {
      "anyOf": [
        {
          "enum": [
            "primary",
            "candidate"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal Role"
    },
    "intl_notes": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/LocalizedText"
      },
      "title": "Intl Notes",
      "type": "array"
    },
    "match_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Match Id",
      "type": "string"
    },
    "opportunity_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Opportunity Id",
      "type": "string"
    },
    "quality_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "来自 Aggregation 的质量置信度；样本不足时为 None",
      "title": "Quality Confidence"
    },
    "reasons": {
      "items": {
        "$ref": "#/components/schemas/LocalizedText"
      },
      "minItems": 1,
      "title": "Reasons",
      "type": "array"
    },
    "risks": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/LocalizedText"
      },
      "title": "Risks",
      "type": "array"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "uncertainty": {
      "$ref": "#/components/schemas/Uncertainty",
      "default": "none"
    },
    "workload_fit": {
      "default": "unknown",
      "enum": [
        "comfortable",
        "tight",
        "over_capacity",
        "unknown"
      ],
      "title": "Workload Fit",
      "type": "string"
    }
  },
  "required": [
    "match_id",
    "opportunity_id",
    "eligibility",
    "score",
    "breakdown",
    "gap_value",
    "reasons"
  ],
  "title": "MatchResult",
  "type": "object"
}
