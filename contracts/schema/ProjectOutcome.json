{
  "$id": "https://campuspath.invalid/schema/ProjectOutcome.json",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "contribution": {
      "maxLength": 2000,
      "title": "Contribution",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "linked_course_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Linked Course Id"
    },
    "linked_opportunity_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Linked Opportunity Id"
    },
    "measurable_result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurable Result"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "project_type": {
      "enum": [
        "course",
        "personal",
        "hackathon",
        "research",
        "startup"
      ],
      "title": "Project Type",
      "type": "string"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "student_id",
    "project_type",
    "title",
    "contribution"
  ],
  "title": "ProjectOutcome",
  "type": "object"
}
