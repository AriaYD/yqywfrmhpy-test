{
  "$defs": {
    "EligibilityStateName": {
      "description": "Spec §16.1。四态，不是两态。",
      "enum": [
        "eligible_now",
        "future_eligible",
        "needs_confirmation",
        "ineligible_current_cycle"
      ],
      "title": "EligibilityStateName",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Spec §14.3。任何进入 Catalog 的事实都必须能回溯到这里。",
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_snippet": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "支撑该结论的原文片段，用于 Unsupported Key Claim 复核（T8）",
          "title": "Evidence Snippet"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source": {
          "description": "来源系统或站点标识",
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "官方页面 URL",
          "title": "Source Url"
        }
      },
      "required": [
        "source",
        "retrieved_at",
        "parser_version"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/EligibilityExplanation.json",
  "additionalProperties": false,
  "description": "A5 面向学生的解释。每条关键论断都要能回溯到来源（T8 < 2%）。",
  "properties": {
    "opportunity_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Opportunity Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/components/schemas/EligibilityStateName"
    },
    "summary": {
      "$ref": "#/components/schemas/LocalizedText"
    },
    "supporting_provenance": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/Provenance"
      },
      "title": "Supporting Provenance",
      "type": "array"
    },
    "validation_id": {
      "pattern": "^val_[0-9a-f]{32}$",
      "title": "Validation Id",
      "type": "string"
    },
    "what_is_missing": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/LocalizedText"
      },
      "title": "What Is Missing",
      "type": "array"
    },
    "when_reachable": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/LocalizedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "opportunity_id",
    "state",
    "summary",
    "validation_id"
  ],
  "title": "EligibilityExplanation",
  "type": "object"
}
