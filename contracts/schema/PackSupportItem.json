{
  "$id": "https://campuspath.invalid/schema/PackSupportItem.json",
  "additionalProperties": false,
  "properties": {
    "application_required": {
      "default": false,
      "title": "Application Required",
      "type": "boolean"
    },
    "category": {
      "maxLength": 40,
      "title": "Category",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "eligibility_summary": {
      "maxLength": 500,
      "title": "Eligibility Summary",
      "type": "string"
    },
    "provider": {
      "maxLength": 200,
      "title": "Provider",
      "type": "string"
    },
    "source_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "support_item_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Support Item Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "support_item_id",
    "category",
    "title",
    "provider",
    "eligibility_summary"
  ],
  "title": "PackSupportItem",
  "type": "object"
}
