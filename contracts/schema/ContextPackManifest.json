{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "PackAvailability": {
      "description": "Pack 不可用时的三种状态。任何一种都不允许模型代为补全内容。",
      "enum": [
        "available",
        "not_installed",
        "source_expired"
      ],
      "title": "PackAvailability",
      "type": "string"
    },
    "PackKind": {
      "enum": [
        "context_pack",
        "career_path_pack"
      ],
      "title": "PackKind",
      "type": "string"
    },
    "PackRule": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "official_source": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "description"
      ],
      "title": "PackRule",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Spec §14.3。任何进入 Catalog 的事实都必须能回溯到这里。",
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_snippet": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "支撑该结论的原文片段，用于 Unsupported Key Claim 复核（T8）",
          "title": "Evidence Snippet"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source": {
          "description": "来源系统或站点标识",
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "官方页面 URL",
          "title": "Source Url"
        }
      },
      "required": [
        "source",
        "retrieved_at",
        "parser_version"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/ContextPackManifest.json",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "default": [],
      "description": "适用条件，例如 'international_student'",
      "items": {
        "type": "string"
      },
      "title": "Applicability",
      "type": "array"
    },
    "availability": {
      "$ref": "#/components/schemas/PackAvailability",
      "default": "available"
    },
    "effective_from": {
      "format": "date",
      "title": "Effective From",
      "type": "string"
    },
    "fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fields",
      "type": "array"
    },
    "jurisdiction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Jurisdiction"
    },
    "kind": {
      "$ref": "#/components/schemas/PackKind"
    },
    "official_sources": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/Provenance"
      },
      "title": "Official Sources",
      "type": "array"
    },
    "pack_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Pack Id",
      "type": "string"
    },
    "review_at": {
      "format": "date",
      "title": "Review At",
      "type": "string"
    },
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/PackRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "uncertainty_policy": {
      "default": "needs_confirmation",
      "enum": [
        "needs_confirmation",
        "block"
      ],
      "title": "Uncertainty Policy",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "pack_id",
    "kind",
    "version",
    "effective_from",
    "review_at"
  ],
  "title": "ContextPackManifest",
  "type": "object"
}
