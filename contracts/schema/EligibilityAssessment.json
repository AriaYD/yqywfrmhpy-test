{
  "$defs": {
    "EligibilityReason": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "rule_kind": {
          "$ref": "#/components/schemas/EligibilityRuleKind"
        },
        "satisfied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None 表示信息不足——这本身就是 needs_confirmation 的依据",
          "title": "Satisfied"
        },
        "source_tier": {
          "title": "Source Tier",
          "type": "string"
        }
      },
      "required": [
        "rule_kind",
        "detail",
        "source_tier"
      ],
      "title": "EligibilityReason",
      "type": "object"
    },
    "EligibilityRuleKind": {
      "enum": [
        "year_level",
        "program",
        "gpa",
        "prerequisite_course",
        "work_authorization",
        "language",
        "membership",
        "application_window",
        "other"
      ],
      "title": "EligibilityRuleKind",
      "type": "string"
    },
    "EligibilityStateName": {
      "description": "Spec §16.1。四态，不是两态。",
      "enum": [
        "eligible_now",
        "future_eligible",
        "needs_confirmation",
        "ineligible_current_cycle"
      ],
      "title": "EligibilityStateName",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/EligibilityAssessment.json",
  "additionalProperties": false,
  "description": "由 Rules & Constraint Engine 判定，A5 只负责解释（Spec §16.5 步骤 1–2）。\n\n**无分数字段。** 排序发生在 :class:`MatchResult`，那是 A5 的产出。",
  "properties": {
    "assessment_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "blocking_requirement_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Blocking Requirement Ids",
      "type": "array"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "next_eligibility_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Eligibility Date"
    },
    "opportunity_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Opportunity Id",
      "type": "string"
    },
    "reasons": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/EligibilityReason"
      },
      "title": "Reasons",
      "type": "array"
    },
    "state": {
      "$ref": "#/components/schemas/EligibilityStateName"
    },
    "validation_id": {
      "description": "Spec §8.9.3：每一条资格结论必须携带 Rules 的校验凭据",
      "pattern": "^val_[0-9a-f]{32}$",
      "title": "Validation Id",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "opportunity_id",
    "state",
    "validation_id",
    "evaluated_at"
  ],
  "title": "EligibilityAssessment",
  "type": "object"
}
