{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/ModerationDecision.json",
  "additionalProperties": false,
  "description": "人工审核的一次决定。不可变——改判需新增一条记录。",
  "properties": {
    "decision": {
      "enum": [
        "approve",
        "request_changes",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "policy_checks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Policy Checks",
      "type": "array"
    },
    "reasons": {
      "items": {
        "$ref": "#/components/schemas/LocalizedText"
      },
      "minItems": 1,
      "title": "Reasons",
      "type": "array"
    },
    "reviewer_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "submission_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Submission Id",
      "type": "string"
    },
    "submission_version": {
      "minimum": 1,
      "title": "Submission Version",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "submission_id",
    "submission_version",
    "reviewer_id",
    "decision",
    "reasons",
    "timestamp"
  ],
  "title": "ModerationDecision",
  "type": "object"
}
