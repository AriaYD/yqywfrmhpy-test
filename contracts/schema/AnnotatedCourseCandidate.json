{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "PrerequisiteStatus": {
      "description": "A2 的标注结果之一。``UNKNOWN`` 必须能传导到 UI，不许悄悄当成 MET。",
      "enum": [
        "met",
        "not_met",
        "in_progress",
        "waived",
        "unknown"
      ],
      "title": "PrerequisiteStatus",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Spec §14.3。任何进入 Catalog 的事实都必须能回溯到这里。",
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_snippet": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "支撑该结论的原文片段，用于 Unsupported Key Claim 复核（T8）",
          "title": "Evidence Snippet"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source": {
          "description": "来源系统或站点标识",
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "官方页面 URL",
          "title": "Source Url"
        }
      },
      "required": [
        "source",
        "retrieved_at",
        "parser_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Uncertainty": {
      "description": "字段级不确定性。``NEEDS_CONFIRMATION`` 永远不能被当成淘汰依据（Spec §16.2）。",
      "enum": [
        "none",
        "low_confidence",
        "missing_source_field",
        "conflicting_sources",
        "needs_confirmation"
      ],
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/AnnotatedCourseCandidate.json",
  "additionalProperties": false,
  "description": "A2 产出（Spec §14.2）。**不含任何排序分数** —— 排序是 A5 的独占职责。\n\n``workload_estimate_hours_per_week`` 是事实估计而非价值判断，因此允许存在；\n任何名为 score/rank/utility 的字段都会被边界扫描拒绝。",
  "properties": {
    "candidate_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "conflict_flags": {
      "default": [],
      "description": "与已选课程/考试/保护区块的冲突标记，由 Capacity+Rules 提供",
      "items": {
        "type": "string"
      },
      "title": "Conflict Flags",
      "type": "array"
    },
    "course_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Course Id",
      "type": "string"
    },
    "offering_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Offering Id"
    },
    "offering_term": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Offering Term"
    },
    "prerequisite_detail": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/LocalizedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prerequisite_status": {
      "$ref": "#/components/schemas/PrerequisiteStatus",
      "default": "unknown"
    },
    "satisfies_requirement_groups": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Satisfies Requirement Groups",
      "type": "array"
    },
    "skill_tags": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Skill Tags",
      "type": "array"
    },
    "source": {
      "$ref": "#/components/schemas/Provenance"
    },
    "uncertainty": {
      "$ref": "#/components/schemas/Uncertainty",
      "default": "none"
    },
    "workload_estimate_hours_per_week": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workload Estimate Hours Per Week"
    }
  },
  "required": [
    "candidate_id",
    "course_id",
    "source"
  ],
  "title": "AnnotatedCourseCandidate",
  "type": "object"
}
