{
  "$defs": {
    "CourseStatus": {
      "enum": [
        "planned",
        "enrolled",
        "completed",
        "dropped",
        "waitlisted"
      ],
      "title": "CourseStatus",
      "type": "string"
    },
    "DataUncertainty": {
      "additionalProperties": false,
      "description": "A2 的产出之一：明确说\"这个字段我不确定\"，而不是猜一个值填上（Spec §8.1.1）。",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "kind": {
          "$ref": "#/components/schemas/Uncertainty"
        },
        "suggested_action": {
          "default": "none",
          "enum": [
            "ask_student",
            "consult_advisor",
            "check_source",
            "none"
          ],
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "kind"
      ],
      "title": "DataUncertainty",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "RecordSource": {
      "enum": [
        "sis",
        "lms",
        "student_reported",
        "degree_audit"
      ],
      "title": "RecordSource",
      "type": "string"
    },
    "StudentCourseRecord": {
      "additionalProperties": false,
      "properties": {
        "course_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Course Id",
          "type": "string"
        },
        "credits": {
          "minimum": 0,
          "title": "Credits",
          "type": "number"
        },
        "grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "仅在学生授权 SIS_RECORDS 时填充；未授权时为 None 而非 'N/A'",
          "title": "Grade"
        },
        "grade_scope": {
          "default": "not_released",
          "enum": [
            "letter",
            "pass_fail",
            "audit",
            "not_released",
            "withheld"
          ],
          "title": "Grade Scope",
          "type": "string"
        },
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/components/schemas/RecordSource"
        },
        "status": {
          "$ref": "#/components/schemas/CourseStatus"
        },
        "student_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Student Id",
          "type": "string"
        },
        "term": {
          "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
          "title": "Term",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "student_id",
        "course_id",
        "term",
        "status",
        "credits",
        "source",
        "updated_at"
      ],
      "title": "StudentCourseRecord",
      "type": "object"
    },
    "Uncertainty": {
      "description": "字段级不确定性。``NEEDS_CONFIRMATION`` 永远不能被当成淘汰依据（Spec §16.2）。",
      "enum": [
        "none",
        "low_confidence",
        "missing_source_field",
        "conflicting_sources",
        "needs_confirmation"
      ],
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/AcademicState.json",
  "additionalProperties": false,
  "description": "A2 输出：SIS/LMS/Degree/Catalog 调和后的学业事实。",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "course_records": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/StudentCourseRecord"
      },
      "title": "Course Records",
      "type": "array"
    },
    "current_term": {
      "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
      "title": "Current Term",
      "type": "string"
    },
    "current_term_credits": {
      "default": 0.0,
      "minimum": 0,
      "title": "Current Term Credits",
      "type": "number"
    },
    "lms_workload_signal": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "LMS 侧的负荷代理（未完成作业数等）；非成绩、非评价",
      "title": "Lms Workload Signal"
    },
    "source_conflicts": {
      "default": [],
      "description": "SIS 与 LMS 冲突时如实上报，不擅自择一",
      "items": {
        "$ref": "#/components/schemas/DataUncertainty"
      },
      "title": "Source Conflicts",
      "type": "array"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "as_of",
    "current_term"
  ],
  "title": "AcademicState",
  "type": "object"
}
