{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "PackAvailability": {
      "description": "Pack 不可用时的三种状态。任何一种都不允许模型代为补全内容。",
      "enum": [
        "available",
        "not_installed",
        "source_expired"
      ],
      "title": "PackAvailability",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/PackResolution.json",
  "additionalProperties": false,
  "description": "A0 加载 Pack 的结果。不可用时**必须**返回可展示的说明，而不是静默跳过。",
  "properties": {
    "availability": {
      "$ref": "#/components/schemas/PackAvailability"
    },
    "message": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/LocalizedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pack_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Pack Id",
      "type": "string"
    },
    "resolved_at": {
      "format": "date-time",
      "title": "Resolved At",
      "type": "string"
    }
  },
  "required": [
    "pack_id",
    "availability",
    "resolved_at"
  ],
  "title": "PackResolution",
  "type": "object"
}
