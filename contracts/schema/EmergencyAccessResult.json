{
  "$defs": {
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/EmergencyAccessResult.json",
  "additionalProperties": false,
  "description": "第三层：紧急红按钮。跳过一切排队，直接给值班室负责人电话。\n\n防滥用（用户裁定）：每学期最多按 2 次，第 3 次起拉黑一学期。\n安全底线：即使被拉黑，拒绝响应里也必须带校园热线号码——\n防滥用挡的是\"跳过排队\"的特权，不挡求助信息本身。",
  "properties": {
    "blacklisted": {
      "default": false,
      "title": "Blacklisted",
      "type": "boolean"
    },
    "duty_phone": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Duty Phone",
      "type": "string"
    },
    "note": {
      "$ref": "#/components/schemas/LocalizedText"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "uses_this_term": {
      "minimum": 0,
      "title": "Uses This Term",
      "type": "integer"
    }
  },
  "required": [
    "student_id",
    "duty_phone",
    "uses_this_term",
    "note"
  ],
  "title": "EmergencyAccessResult",
  "type": "object"
}
