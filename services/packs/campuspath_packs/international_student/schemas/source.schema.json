{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuspath.example/schemas/source.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "required": ["source_id", "title", "url", "publisher", "authority_tier", "jurisdiction", "topics", "language", "effective_from", "effective_until", "last_checked_at", "next_review_at", "review_interval_days", "http_status", "status"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "url": {"type": "string", "pattern": "^https://"},
    "publisher": {"type": "string", "minLength": 1},
    "authority_tier": {"type": "integer", "minimum": 1, "maximum": 5},
    "jurisdiction": {"type": "string"},
    "institution": {"type": ["string", "null"]},
    "topics": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "language": {"type": "string"},
    "published_at": {"type": ["string", "null"], "format": "date"},
    "effective_from": {"type": ["string", "null"], "format": "date"},
    "effective_until": {"type": ["string", "null"], "format": "date"},
    "last_checked_at": {"type": "string", "format": "date-time"},
    "next_review_at": {"type": "string", "format": "date"},
    "review_interval_days": {"type": "integer", "minimum": 1},
    "http_status": {"type": ["integer", "null"]},
    "content_hash": {"type": ["string", "null"]},
    "status": {"enum": ["active", "changed", "unavailable", "superseded"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
