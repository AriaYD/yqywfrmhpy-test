{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuspath.example/schemas/procedure.schema.json",
  "title": "InstitutionProcedure",
  "type": "object",
  "required": ["procedure_id", "title", "description", "source_ids"],
  "properties": {
    "procedure_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
