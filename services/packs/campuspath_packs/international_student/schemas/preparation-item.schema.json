{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuspath.example/schemas/preparation-item.schema.json",
  "title": "PreparationItem",
  "type": "object",
  "required": ["preparation_action_id", "category", "title", "description", "recommended_lead_time_days", "trigger_conditions", "mandatory", "mandatory_source_id", "source_ids"],
  "properties": {
    "preparation_action_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "category": {"enum": ["language", "documents", "work_authorization", "job_search", "finance", "timeline"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "recommended_lead_time_days": {"type": ["integer", "null"], "minimum": 0},
    "trigger_conditions": {"type": "array"},
    "mandatory": {"type": "boolean"},
    "mandatory_source_id": {"type": ["string", "null"]},
    "source_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

